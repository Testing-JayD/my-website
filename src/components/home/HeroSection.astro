---
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import { siteConfig } from "@/config/site";
import {
	ArrowRight,
	CheckCircle2,
	Coins,
	FileSpreadsheet,
	PiggyBank,
	Scale,
	ShieldCheck,
	TrendingUp,
} from "@lucide/astro";

const highlights = [
	{
		title: "Fixed Monthly Fee",
		desc: "0% cut taken from your tips. Keep 100% of gratuities with your team.",
		badge: "No % Charges",
	},
	{
		title: "Single Payroll Run",
		desc: "Tronc and PAYE processed together. No duplicate data entry or sync errors.",
		badge: "1 Submission",
	},
	{
		title: "Tips Act 2023 Compliant",
		desc: "Full statutory compliance with HMRC independent TroncMaster status.",
		badge: "Audited & Legal",
	},
	{
		title: "Zero NIC on Tronc",
		desc: "Properly operated tronc saves up to 13.8% Employer & Employee NI.",
		badge: "HMRC Compliant",
	},
];
---

<section class="relative z-20 site-container pt-12 md:pt-20 lg:pt-28">
	<div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
		<div>
			<div class="mb-5 flex flex-wrap gap-2">
				<Badge variant="primary">Independent TroncMaster</Badge>
				<Badge variant="accent">Payroll Bureau for UK Hospitality</Badge>
			</div>

			<h1 class="mb-5 max-w-3xl text-4xl leading-tight font-extrabold tracking-tight md:text-5xl lg:text-6xl text-neutral-900 dark:text-white">
				Tronc and payroll, <span class="text-primary underline decoration-primary/30 underline-offset-4">perfectly in sync.</span>
			</h1>

			<p class="mb-7 max-w-2xl text-base md:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed">
				Stop losing 1% to 3% of your team’s hard-earned tips to traditional operators. We unite independent <strong>TroncMaster governance</strong> and <strong>complete payroll bureau delivery</strong> under one roof — with a transparent, fixed monthly fee regardless of tip volume.
			</p>

			<div class="flex flex-wrap items-center gap-4">
				<Button url="/contact" type="fill">
					Get a Free Quote <ArrowRight size={16} />
				</Button>
				<Button url="/pricing">
					View Pricing & Packages
				</Button>
			</div>

			<!-- Quick Trust Badges -->
			<div class="mt-8 flex flex-wrap items-center gap-6 border-t border-neutral-200/80 pt-6 text-xs text-neutral-600 dark:border-neutral-800 dark:text-neutral-400">
				<span class="flex items-center gap-1.5 font-medium">
					<CheckCircle2 class="h-4 w-4 text-primary" /> 100% Tips Act Compliant
				</span>
				<span class="flex items-center gap-1.5 font-medium">
					<CheckCircle2 class="h-4 w-4 text-primary" /> HMRC Independent Status
				</span>
				<span class="flex items-center gap-1.5 font-medium">
					<CheckCircle2 class="h-4 w-4 text-primary" /> Fixed Price Guarantee
				</span>
			</div>
		</div>

		<!-- Right Side: Value Card Graphic -->
		<div class="relative">
			<BrowserFrame url="troncpaye.co.uk/portal">
				<div class="p-5 md:p-6 bg-white dark:bg-neutral-900">
					<div class="mb-5 flex items-center justify-between border-b border-neutral-100 pb-4 dark:border-neutral-800">
						<div>
							<p class="text-xs uppercase font-bold tracking-wider text-primary">The TroncPAYE Standard</p>
							<p class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">Combined Scheme Breakdown</p>
						</div>
						<span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
							Active & Compliant
						</span>
					</div>

					<!-- Savings vs Traditional Callout -->
					<div class="mb-4 rounded-xl border border-primary/20 bg-primary/5 p-4 text-left dark:bg-primary/10">
						<div class="flex items-center justify-between">
							<span class="text-xs font-semibold text-neutral-500 dark:text-neutral-400">Traditional Tronc Fee (2%)</span>
							<span class="text-xs font-bold text-rose-500 line-through">£400 - £1,200/mo</span>
						</div>
						<div class="mt-2 flex items-center justify-between">
							<span class="text-sm font-bold text-neutral-800 dark:text-neutral-100">TroncPAYE Monthly Fee</span>
							<span class="text-base font-extrabold text-primary">Fixed Flat Fee</span>
						</div>
						<p class="mt-2 text-[11px] text-neutral-500 dark:text-neutral-400">
							Tip volumes fluctuate; your Tronc administrative cost never does.
						</p>
					</div>

					<!-- Grid Features -->
					<div class="grid grid-cols-2 gap-3">
						{highlights.map((item) => (
							<div class="rounded-lg border border-neutral-200/80 bg-neutral-50/70 p-3 dark:border-neutral-800 dark:bg-neutral-800/40">
								<span class="inline-block rounded bg-primary/10 px-2 py-0.5 text-[10px] font-bold text-primary dark:bg-primary/20">
									{item.badge}
								</span>
								<p class="mt-2 text-xs font-bold text-neutral-800 dark:text-neutral-100">{item.title}</p>
								<p class="mt-1 text-[11px] leading-snug text-neutral-500 dark:text-neutral-400">{item.desc}</p>
							</div>
						))}
					</div>
				</div>
			</BrowserFrame>
		</div>
	</div>
</section>