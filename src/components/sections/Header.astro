---
import { ArrowRight, ChevronDown, ChevronRight, Menu, X } from "@lucide/astro";
import menus from "@/collections/menu.json";
import Button from "@/components/ui/Button.astro";
import Logo from "@/components/ui/Logo.astro";

type MenuItem = {
  name: string;
  url?: string;
  children?: Array<{ name: string; url: string }>;
};

const menuItems = menus as MenuItem[];
---

<div class="relative w-full h-16 sm:h-20 opacity-0 pointer-events-none"></div>

<header id="header" class="fixed top-2 sm:top-4 z-50 w-full px-3 sm:px-4 lg:px-6">
  <div id="site-container"
    class="flex items-center justify-between h-14 sm:h-15 site-container mx-auto px-4 sm:px-6 py-2.5 border-transparent border-[0.5px] transition-all duration-300"
  >
    <div class="flex-shrink-0 z-50">
      <Logo />
    </div>

    <div
      id="mobileMenuBackground"
      class="fixed inset-0 z-20 hidden w-screen h-screen duration-300 ease-out bg-white/90 backdrop-blur-sm dark:bg-neutral-950/90"
    >
    </div>

    <nav
      class="relative z-30 flex flex-row-reverse justify-start w-full text-sm sm:justify-end text-neutral-500 dark:text-neutral-400 sm:flex-row sm:items-center"
    >
      <div class="flex items-center gap-2 sm:hidden">
        <button
          type="button"
          id="openMenu"
          aria-label="Open menu"
          class="flex items-center justify-center w-10 h-10 cursor-pointer rounded-full bg-gradient-to-b from-white to-bg-primary-light border-[0.5px] border-primary/10 dark:from-neutral-800 dark:to-bg-secondary-dark dark:border-neutral-600 transition-all duration-200 hover:shadow-md active:scale-90"
        >
          <Menu class="w-5 h-5 text-neutral-700 dark:text-neutral-200" stroke-width={2} />
        </button>

        <button
          type="button"
          id="closeMenu"
          aria-label="Close menu"
          class="hidden items-center justify-center w-10 h-10 cursor-pointer rounded-full bg-gradient-to-b from-white to-bg-primary-light border-[0.5px] border-primary/10 dark:from-neutral-800 dark:to-bg-secondary-dark dark:border-neutral-600 transition-all duration-200 hover:shadow-md active:scale-90"
        >
          <X class="w-5 h-5 text-neutral-700 dark:text-neutral-200" stroke-width={2} />
        </button>
      </div>

      <div
        id="menu"
        class="fixed top-[68px] sm:top-0 left-3 right-3 sm:left-0 sm:right-0 ease-out duration-300 z-40 flex-col items-center justify-start hidden w-auto max-h-[calc(100dvh-84px)] overflow-y-auto text-sm pt-4 pb-4 sm:max-h-none sm:overflow-visible sm:py-0 sm:relative sm:flex-row sm:flex"
      >
        <div class="absolute inset-0 top-0 right-0 block w-full h-full sm:hidden">
          <div class="relative w-full h-full bg-white/95 dark:bg-bg-primary-dark/95 border border-dashed border-neutral-300 dark:border-neutral-700 backdrop-blur-md rounded-2xl shadow-lg"></div>
        </div>

        <div class="relative z-10 flex flex-col sm:flex-row items-stretch sm:items-center w-full sm:w-auto px-2 sm:px-0 gap-0.5 sm:gap-0">
          <div class="block sm:hidden px-3 pt-1 pb-2">
            <span class="text-[10px] font-medium uppercase tracking-[0.14em] text-neutral-400 dark:text-neutral-500">Navigation</span>
          </div>
          {
            menuItems.map((menu) => {
              if (menu.children && menu.children.length > 0) {
                return (
                  <div class="dropdown-wrapper relative w-full sm:w-auto" data-open="false">
                    <button
                      type="button"
                      class="dropdown-toggle group relative flex items-center justify-between sm:justify-center w-full sm:w-auto px-3 py-3 sm:py-2 sm:px-3 md:px-4 font-medium tracking-wide duration-200 ease-out rounded-lg sm:rounded-none text-neutral-700 dark:text-neutral-200 hover:text-primary hover:bg-primary/5 sm:hover:bg-transparent dark:hover:text-white dark:hover:bg-primary/10 sm:dark:hover:bg-transparent active:scale-[0.98] sm:active:scale-100 transition-all gap-1 text-left sm:text-center"
                      aria-expanded="false"
                      aria-haspopup="true"
                    >
                      <span class="flex-1 sm:flex-initial">{menu.name}</span>
                      <ChevronDown class="dropdown-chevron w-4 h-4 transition-transform duration-200 text-neutral-400 group-hover:text-primary dark:text-neutral-500" />
                    </button>
                    <div class="dropdown-panel sm:absolute sm:top-full sm:left-1/2 sm:mt-2 sm:min-w-[200px] sm:rounded-xl sm:border sm:border-dashed sm:border-primary/20 dark:sm:border-neutral-700 sm:bg-white/95 dark:sm:bg-bg-secondary-dark sm:p-2 hidden sm:invisible sm:opacity-0 sm:flex sm:flex-col sm:transition-all sm:duration-200">
                      {menu.children.map((child) => (
                        <a
                          href={child.url}
                          class="dropdown-link group/link flex items-center justify-between sm:justify-start w-full px-3 sm:px-4 py-2.5 sm:py-2 rounded-md text-sm font-medium text-neutral-600 dark:text-neutral-300 hover:text-primary dark:hover:text-primary-light hover:bg-primary/5 dark:hover:bg-primary/10 transition-colors duration-150 text-left"
                        >
                          <span>{child.name}</span>
                          <ChevronRight class="w-3.5 h-3.5 sm:hidden text-neutral-300 dark:text-neutral-600 group-hover/link:text-primary transition-colors" />
                        </a>
                      ))}
                    </div>
                  </div>
                );
              }
              return (
                <a
                  href={menu.url}
                  class="group relative flex items-center justify-between sm:justify-center w-full sm:w-auto px-3 py-3 sm:py-2 sm:px-3 md:px-4 font-medium tracking-wide duration-200 ease-out rounded-lg sm:rounded-none text-neutral-700 dark:text-neutral-200 hover:text-primary hover:bg-primary/5 sm:hover:bg-transparent dark:hover:text-white dark:hover:bg-primary/10 sm:dark:hover:bg-transparent active:scale-[0.98] sm:active:scale-100 transition-all text-left sm:text-center"
                >
                  <span>{menu.name}</span>
                  <ChevronRight class="w-4 h-4 sm:hidden text-neutral-300 dark:text-neutral-600 group-hover:text-primary group-hover:translate-x-0.5 transition-all" />
                </a>
              );
            })
          }
        </div>

        <div class="relative z-10 w-full px-5 sm:hidden mt-3">
          <div class="w-full border-t border-dashed border-neutral-200 dark:border-neutral-700"></div>
        </div>

        <div class="relative z-10 w-full px-5 mt-4 sm:hidden">
          <Button url="/contact" type="fill" className="w-full justify-center flex items-center gap-2 shadow-sm font-bold">
            Get a Quote <ArrowRight class="w-4 h-4" />
          </Button>
        </div>
      </div>

      <div class="relative hidden sm:flex items-center ml-4 lg:ml-6">
        <Button url="/contact" type="fill" className="whitespace-nowrap flex items-center gap-1.5 shadow-sm font-bold px-4 py-2">
          Get a Quote <ArrowRight class="w-4 h-4" />
        </Button>
      </div>
    </nav>
  </div>
</header>
<style>
  #site-container {
    background-color: transparent;
    border-color: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: blur(0);
    backdrop-filter: blur(0);
  }

  #site-container.is-scrolled {
   background-color: rgba(255, 255, 255, 0.97);
    border-color: rgba(45, 109, 195, 0.12);
    box-shadow: 0 8px 24px rgba(16, 22, 31, 0.08);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-radius: 1rem;
  }

  :global(html.dark) #site-container.is-scrolled {
    background-color: rgba(15, 27, 45, 0.97);
    border-color: rgba(197, 206, 219, 0.12);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-container {
      transition: none !important;
    }
  }
</style>

<script>
  const siteContainer = document.getElementById("site-container");

  function updateHeaderBackground() {
    siteContainer?.classList.toggle(
      "is-scrolled",
      window.scrollY > 24
    );
  }

  updateHeaderBackground();

  window.addEventListener("scroll", updateHeaderBackground, {
    passive: true,
  });
</script>