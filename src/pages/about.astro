---
import Layout from "@/layouts/Layout.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import {
	ArrowRight,
	Building2,
	CheckCircle2,
	HeartHandshake,
	Percent,
	Scale,
	ShieldCheck,
	Sparkles,
	Target,
	Users,
} from "@lucide/astro";

const values = [
	{
		icon: Percent,
		title: "Fixed-Fee Integrity",
		desc: "We believe tips belong to hospitality staff. We never take a percentage cut of gratuities. Our fee is fixed, predictable, and fair.",
	},
	{
		icon: Scale,
		title: "Independent Governance",
		desc: "As an autonomous TroncMaster, we protect employers from HMRC National Insurance liabilities and ensure 100% compliance with the Tips Act 2023.",
	},
	{
		icon: HeartHandshake,
		title: "Single-Point Simplicity",
		desc: "By unifying tronc administration and payroll into one bureau, we eliminate duplicate spreadsheets, cross-vendor delays, and administrative chaos.",
	},
	{
		icon: Target,
		title: "Hospitality Specialists",
		desc: "We understand variable rotas, zero-hour contracts, seasonal fluctuations, and high turnover. Our systems are built solely for this industry.",
	},
];

const milestones = [
	{
		title: "The Problem We Witnessed",
		desc: "For years, hospitality operators faced an unfair choice: run tronc internally and risk HMRC non-compliance and NIC liabilities, or pay traditional operators 1% to 3% of their staff's hard-earned tips while juggling a separate payroll bureau.",
	},
	{
		title: "The TroncPAYE Solution",
		desc: "We integrated independent TroncMaster governance directly into a professional hospitality payroll bureau. The result: one data upload, one point of contact, zero tip commission, and airtight statutory compliance.",
	},
	{
		title: "Our Mission Today",
		desc: "To deliver transparent, technology-backed payroll and tronc schemes to UK restaurants, pubs, bars, and hotels, saving operators time and protecting staff earnings.",
	},
];
---

<Layout
	title="About Us | TroncPAYE"
	description="Learn how TroncPAYE is transforming hospitality payroll and tronc administration with fixed fees and combined single-bureau delivery."
	keywords="about troncpaye, hospitality payroll team, independent troncmaster, uk restaurant payroll"
>
	<!-- Hero Section -->
	<section class="site-container pt-16 pb-12 text-center md:pt-24 md:pb-16">
		<div class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-semibold text-primary">
			<Building2 class="h-3.5 w-3.5" /> Our Story & Mission
		</div>
		<h1 class="mx-auto mb-4 max-w-3xl text-4xl font-extrabold tracking-tight md:text-5xl lg:text-6xl text-neutral-900 dark:text-white">
			Built to End the <span class="text-primary">Dual-Bureau Headache</span>
		</h1>
		<p class="mx-auto max-w-2xl text-base md:text-lg text-neutral-600 dark:text-neutral-300">
			We merged independent TroncMaster oversight with a specialized hospitality payroll bureau to give operators a fairer, simpler, and more transparent solution.
		</p>
	</section>

	<!-- Story Cards -->
	<section class="site-container py-8 md:py-12">
		<div class="grid gap-6 md:grid-cols-3">
			{milestones.map((item, idx) => (
				<div class="rounded-2xl border border-neutral-200/80 bg-white p-8 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
					<span class="font-mono text-xs font-bold uppercase tracking-wider text-primary">Stage 0{idx + 1}</span>
					<h3 class="mt-2 mb-3 text-xl font-bold text-neutral-900 dark:text-white">{item.title}</h3>
					<p class="text-xs leading-relaxed text-neutral-600 dark:text-neutral-400">{item.desc}</p>
				</div>
			))}
		</div>
	</section>

	<!-- Core Values -->
	<section class="site-container py-12 md:py-20">
		<SectionHeader
			title="What Sets TroncPAYE Apart"
			description="Our operational principles guarantee transparency for your business and fairness for your team."
		/>
		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{values.map((val) => (
				<div class="rounded-xl border border-neutral-200/80 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-900">
					<div class="mb-4 grid h-12 w-12 place-items-center rounded-xl bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light">
						<val.icon class="h-6 w-6" />
					</div>
					<h3 class="mb-2 text-base font-bold text-neutral-900 dark:text-white">{val.title}</h3>
					<p class="text-xs leading-relaxed text-neutral-600 dark:text-neutral-400">{val.desc}</p>
				</div>
			))}
		</div>
	</section>

	<!-- Compliance & Trust Banner -->
	<section class="site-container py-8 md:py-12">
		<div class="rounded-2xl border border-primary/20 bg-primary/5 p-8 md:p-12 dark:bg-primary/10">
			<div class="grid items-center gap-8 lg:grid-cols-[1.2fr_0.8fr]">
				<div>
					<span class="rounded-md bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary dark:bg-primary/20">
						Airtight Statutory Protection
					</span>
					<h2 class="mt-3 text-2xl font-extrabold text-neutral-900 md:text-3xl dark:text-white">
						Full Employment (Allocation of Tips) Act 2023 Compliance
					</h2>
					<p class="mt-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
						Under the statutory Code of Practice, operators must ensure that all tips and service charges are allocated fairly, transparently, and without unlawful deductions. TroncPAYE acts as the legal buffer between employer and tronc distribution, producing the required audit trails and keeping your business entirely protected.
					</p>
				</div>
				<div class="flex flex-col gap-3 rounded-xl bg-white p-6 shadow-sm dark:bg-neutral-800">
					<div class="flex items-center gap-3 text-sm font-semibold text-neutral-800 dark:text-neutral-200">
						<CheckCircle2 class="h-5 w-5 text-primary flex-none" />
						<span>Independent Tronc Ruleset Documentation</span>
					</div>
					<div class="flex items-center gap-3 text-sm font-semibold text-neutral-800 dark:text-neutral-200">
						<CheckCircle2 class="h-5 w-5 text-primary flex-none" />
						<span>Zero Employer Direction Over Allocation</span>
					</div>
					<div class="flex items-center gap-3 text-sm font-semibold text-neutral-800 dark:text-neutral-200">
						<CheckCircle2 class="h-5 w-5 text-primary flex-none" />
						<span>Exemption from Class 1 Employer & Employee NIC</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="site-container py-12 md:py-20">
		<div class="rounded-2xl bg-neutral-900 p-8 text-center text-white md:p-12 dark:bg-[#0c1630]">
			<h2 class="text-2xl font-extrabold md:text-3xl">Partner With Hospitality Payroll Experts</h2>
			<p class="mt-2 text-white/80 max-w-xl mx-auto text-sm">
				Find out how much time and money your venue can save with a unified scheme and fixed-fee tronc management.
			</p>
			<div class="mt-6 flex flex-wrap justify-center gap-4">
				<Button url="/contact" type="fill">
					Get a Custom Quote <ArrowRight size={16} />
				</Button>
				<Button url="/pricing">
					Compare Packages
				</Button>
			</div>
		</div>
	</section>
</Layout>
