---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import {
	ArrowRight,
	Banknote,
	CircleCheck,
	Clock,
	Layers,
	Scale,
} from "@lucide/astro";

const troncFeatures = [
	"Full compliance with the Employment (Allocation of Tips) Act 2023",
	"HMRC-approved independent TroncMaster status",
	"Exemption from Class 1 Primary & Secondary National Insurance on tips",
	"Fixed monthly fee — 0% commission taken from your staff's tips",
	"Independent tronc committee creation and ruleset documentation",
	"Transparent reporting and audit trails for staff and HMRC",
];

const payrollFeatures = [
	"Full PAYE calculations, tax codes, and statutory payments (SSP, SMP, etc.)",
	"Real-Time Information (RTI) submissions to HMRC on every pay cycle",
	"Workplace pension auto-enrolment and contribution management",
	"Specialist handling for high-turnover, variable-hour hospitality teams",
	"Secure 24/7 digital employee payslips portal",
	"National Minimum Wage (NMW) compliance safeguards",
];

const combinedBenefits = [
	{
		title: "Single Monthly Submission",
		desc: "Upload hours and card tip figures once. We handle basic wages and tronc distributions in tandem.",
	},
	{
		title: "Zero Dual-Bureau Friction",
		desc: "No more chasing a separate payroll clerk and an external tronc provider to correct mismatching figures.",
	},
	{
		title: "Itemised, Unified Payslips",
		desc: "Staff receive one payslip clearly displaying standard hourly pay alongside tax-efficient tronc earnings.",
	},
	{
		title: "Cost-Effective Flat Retainer",
		desc: "Bundled pricing that guarantees significant savings compared to paying two independent vendors.",
	},
];
---

<Layout
	title="Our Services | TroncPAYE Hospitality Bureau"
	description="Independent TroncMaster services, specialist hospitality payroll bureau, and combined single-scheme solutions for UK venues."
	keywords="troncmaster services, hospitality payroll bureau, tips act compliance, restaurant payroll, tronc management"
>
	<section class="site-container pt-16 pb-12 text-center md:pt-24 md:pb-16">
		<div class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-semibold text-primary">
			<Layers class="h-3.5 w-3.5" /> Comprehensive Hospitality Solutions
		</div>
		<h1 class="mx-auto mb-4 max-w-3xl text-4xl font-extrabold tracking-tight md:text-5xl lg:text-6xl text-neutral-900 dark:text-white">
			Hospitality Payroll & Tronc, <span class="text-primary">Without the Admin Friction</span>
		</h1>
		<p class="mx-auto max-w-2xl text-base md:text-lg text-neutral-600 dark:text-neutral-300">
			Whether you need an independent TroncMaster, a dedicated payroll bureau, or a unified single-point solution, we protect your margins and ensure total compliance.
		</p>
	</section>

	<section id="tronc" class="site-container py-12 md:py-16">
		<div class="rounded-2xl border border-neutral-200/80 bg-white p-8 shadow-sm dark:border-neutral-800 dark:bg-neutral-900 md:p-12">
			<div class="grid items-center gap-10 lg:grid-cols-2">
				<div>
					<div class="mb-4 inline-flex items-center gap-2 rounded-md bg-primary/10 px-3 py-1 text-xs font-bold text-primary dark:bg-primary/20">
						<Scale class="h-4 w-4" /> Service 01
					</div>
					<h2 class="mb-4 text-3xl font-extrabold text-neutral-900 md:text-4xl dark:text-white">
						Independent TroncMaster Services
					</h2>
					<p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">
						The Employment (Allocation of Tips) Act makes fair, transparent tip distribution a legal requirement. Operating a tronc scheme yourself exposes you to HMRC compliance scrutiny and potential National Insurance liabilities. We act as your fully independent, legally recognised TroncMaster.
					</p>
					<ul class="space-y-3">
						{troncFeatures.map((feat) => (
							<li class="flex items-start gap-3 text-sm text-neutral-700 dark:text-neutral-300">
								<CircleCheck class="h-5 w-5 flex-none text-primary mt-0.5" />
								<span>{feat}</span>
							</li>
						))}
					</ul>
					<div class="mt-8">
						<Button url="/contact" type="fill">
							Enquire About Tronc Services <ArrowRight size={16} />
						</Button>
					</div>
				</div>

				<div class="rounded-xl border border-primary/20 bg-primary/5 p-6 dark:bg-primary/10">
					<div class="rounded-lg bg-white p-6 shadow-sm dark:bg-neutral-800">
						<p class="text-xs uppercase font-bold tracking-wider text-primary">The TroncPAYE Advantage</p>
						<h3 class="mt-1 text-xl font-bold text-neutral-900 dark:white">Never a % Cut</h3>
						<p class="mt-3 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
							Traditional providers claim 1% to 4% of your team's tips every month. That means during busy seasonal periods, your tronc costs spiral. With TroncPAYE, you pay one predictable monthly retainer, keeping 100% of gratuities with your hard-working staff.
						</p>
						<div class="mt-6 border-t border-neutral-100 pt-4 dark:border-neutral-700">
							<span class="text-xs font-semibold text-neutral-500">Savings Guarantee</span>
							<p class="text-lg font-extrabold text-primary">100% of tips go to your team</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="payroll" class="site-container py-12 md:py-16">
		<div class="rounded-2xl border border-neutral-200/80 bg-white p-8 shadow-sm dark:border-neutral-800 dark:bg-neutral-900 md:p-12">
			<div class="grid items-center gap-10 lg:grid-cols-2">
				<div class="order-2 lg:order-1 rounded-xl border border-neutral-200 bg-neutral-50/70 p-6 dark:border-neutral-800 dark:bg-neutral-800/40">
					<div class="rounded-lg bg-white p-6 shadow-sm dark:bg-neutral-800">
						<p class="text-xs uppercase font-bold tracking-wider text-primary">Hospitality-Specific Bureau</p>
						<h3 class="mt-1 text-xl font-bold text-neutral-900 dark:text-white">Built for Rota Volatility</h3>
						<p class="mt-3 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
							Standard corporate accountants often struggle with hospitality payroll: fluctuating rotas, shift covers, zero-hour contracts, and high staff turnover. We specialize solely in the fast-moving rhythm of hospitality teams.
						</p>
						<div class="mt-6 flex items-center gap-3 border-t border-neutral-100 pt-4 dark:border-neutral-700">
							<Clock class="h-5 w-5 text-primary" />
							<span class="text-xs font-semibold text-neutral-700 dark:text-neutral-300">Fast turnaround on weekly or monthly pay runs</span>
						</div>
					</div>
				</div>

				<div class="order-1 lg:order-2">
					<div class="mb-4 inline-flex items-center gap-2 rounded-md bg-primary/10 px-3 py-1 text-xs font-bold text-primary dark:bg-primary/20">
						<Banknote class="h-4 w-4" /> Service 02
					</div>
					<h2 class="mb-4 text-3xl font-extrabold text-neutral-900 md:text-4xl dark:text-white">
						Hospitality Payroll Provision
					</h2>
					<p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">
						Accurate, timely payroll compliant with all statutory obligations. We take the paperwork off your desk so your general managers can focus on front-of-house service and customer satisfaction.
					</p>
					<ul class="space-y-3">
						{payrollFeatures.map((feat) => (
							<li class="flex items-start gap-3 text-sm text-neutral-700 dark:text-neutral-300">
								<CircleCheck class="h-5 w-5 flex-none text-primary mt-0.5" />
								<span>{feat}</span>
							</li>
						))}
					</ul>
					<div class="mt-8">
						<Button url="/contact" type="outline">
							Discuss Payroll Requirements <ArrowRight size={16} />
						</Button>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="combined" class="site-container py-12 md:py-20">
		<div class="rounded-2xl bg-neutral-900 p-8 text-white md:p-14 dark:bg-[#0c1630] border border-primary/20">
			<div class="text-center max-w-3xl mx-auto mb-12">
				<Badge variant="accent">Flagship Solution</Badge>
				<h2 class="mt-4 text-3xl font-extrabold md:text-4xl text-white">
					The Combined Scheme: Tronc & Payroll in Sync
				</h2>
				<p class="mt-4 text-neutral-300 text-base md:text-lg">
					Why pay two separate providers and duplicate your data entry? Merging your TroncMaster and Payroll Bureau saves hours of admin every pay run and guarantees airtight HMRC compliance.
				</p>
			</div>

			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{combinedBenefits.map((item) => (
					<div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur">
						<h3 class="mb-2 text-base font-bold text-white">{item.title}</h3>
						<p class="text-xs leading-relaxed text-neutral-300">{item.desc}</p>
					</div>
				))}
			</div>

			<div class="mt-12 text-center">
				<Button url="/pricing" type="fill">
					See Package Pricing & Compare <ArrowRight size={16} />
				</Button>
			</div>
		</div>
	</section>
</Layout>
