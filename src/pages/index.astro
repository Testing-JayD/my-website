---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Button from "@/components/ui/Button.astro";
import {
	ArrowRight,
	Banknote,
	CircleCheck,
	CircleX,
	Percent,
	Scale,
	ShieldCheck,
	Shuffle,
	Sparkles,
} from "@lucide/astro";

const pillars = [
	{
		icon: Percent,
		title: "Fixed Fee, Zero % Cuts",
		desc: "Traditional tronc masters take a 1% to 4% commission on all card tips and service charges. We charge a flat, transparent monthly fee. Your staff keep what they earn.",
	},
	{
		icon: Shuffle,
		title: "One Combined Bureau",
		desc: "Running PAYE with one provider and Tronc with another doubles payroll admin. We merge both into a unified, smooth monthly process with zero duplicate inputs.",
	},
	{
		icon: ShieldCheck,
		title: "Tips Act 2023 Compliant",
		desc: "The Employment (Allocation of Tips) Act requires absolute fairness and transparent records. We act as your fully independent, legally compliant TroncMaster.",
	},
	{
		icon: Banknote,
		title: "Legitimate NIC Exemption",
		desc: "Because we operate as an independent TroncMaster, your tronc distribution is exempt from National Insurance Contributions (NIC) for both employer and employee.",
	},
];

const steps = [
	{
		step: "01",
		title: "Tronc Scheme Design",
		desc: "We help agree on a fair, compliant tronc distribution ruleset tailored to your venue and team structure.",
	},
	{
		step: "02",
		title: "Monthly Data Submission",
		desc: "Submit your team's hours and card tip totals once each payroll cycle via our straightforward template.",
	},
	{
		step: "03",
		title: "Simultaneous Processing",
		desc: "We calculate basic pay, statutory deductions, and tax-efficient tronc allocations simultaneously.",
	},
	{
		step: "04",
		title: "RTI & Itemised Payslips",
		desc: "We file directly with HMRC and issue clear, compliant payslips separating hourly wages and tronc pay.",
	},
];
---

<Layout
	title="TroncPAYE | TroncMaster & Payroll Bureau Combined"
	description="Merge your TroncMaster and Payroll bureau into one. Protect tip revenues with a fixed monthly fee and full Tips Act compliance."
	keywords="troncmaster, hospitality payroll, tronc scheme, restaurant payroll bureau, tips act 2023"
>
	<HeroSection />

	<section class="site-container py-16 md:py-24">
		<SectionHeader
			title="Why Hospitality Venues Switch to TroncPAYE"
			description="Designed specifically for restaurants, bars, pubs, and hotels looking to protect margins and eliminate administrative headaches."
		/>
		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{pillars.map((item) => (
				<article
					class="rounded-xl border border-neutral-200/80 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900"
				>
					<div class="mb-4 grid h-12 w-12 place-items-center rounded-xl bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light">
						<item.icon class="h-6 w-6" />
					</div>
					<h3 class="mb-2 text-lg font-bold text-neutral-900 dark:text-neutral-100">{item.title}</h3>
					<p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{item.desc}</p>
				</article>
			))}
		</div>
	</section>

	<div class="site-container my-2 border-b border-dashed border-neutral-200 dark:border-neutral-800"></div>

	<section class="site-container py-16 md:py-24">
		<div class="grid items-center gap-10 lg:grid-cols-2">
			<div>
				<div class="mb-3 inline-flex items-center gap-2 rounded-md border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-semibold text-primary">
					<Scale class="h-4 w-4" /> The Cost & Time Comparison
				</div>
				<h2 class="mb-4 text-3xl font-extrabold text-neutral-900 md:text-4xl dark:text-white">
					Tired of paying % commissions on your tips?
				</h2>
				<p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
					Most traditional Tronc providers charge a percentage of your total tip pool. If your team has a busy season, your Tronc bill skyrockets — despite the software doing the exact same amount of work.
				</p>
				<p class="mt-4 text-neutral-600 dark:text-neutral-300 leading-relaxed">
					By combining <strong>TroncMaster duties</strong> directly with your <strong>payroll bureau</strong>, we streamline communications, eliminate double handling, and charge one predictable flat fee.
				</p>
				<div class="mt-8 flex flex-wrap gap-4">
					<Button url="/contact" type="fill">
						Request a Free Quote <ArrowRight size={16} />
					</Button>
					<Button url="/features">
						Explore All Services
					</Button>
				</div>
			</div>

			<div class="grid gap-4 sm:grid-cols-2">
				<div class="rounded-xl border border-rose-200 bg-rose-50/40 p-5 dark:border-rose-950 dark:bg-rose-950/20">
					<div class="mb-3 flex items-center gap-2 text-rose-600 font-bold text-sm">
						<CircleX class="h-5 w-5" /> Traditional Setup
					</div>
					<ul class="space-y-3 text-xs text-neutral-700 dark:text-neutral-300">
						<li class="flex items-start gap-2">
							<span class="text-rose-500 font-bold">✕</span>
							<span>1% – 4% cut taken straight from staff tips</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-rose-500 font-bold">✕</span>
							<span>Separate payroll bureau and Tronc provider</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-rose-500 font-bold">✕</span>
							<span>Double data entry every month</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-rose-500 font-bold">✕</span>
							<span>Confusion when payroll queries arise</span>
						</li>
					</ul>
				</div>

				<div class="rounded-xl border border-primary/30 bg-primary/5 p-5 dark:border-primary/40 dark:bg-primary/10">
					<div class="mb-3 flex items-center gap-2 text-primary font-bold text-sm">
						<CircleCheck class="h-5 w-5" /> The TroncPAYE Way
					</div>
					<ul class="space-y-3 text-xs text-neutral-800 dark:text-neutral-200">
						<li class="flex items-start gap-2">
							<span class="text-primary font-bold">✓</span>
							<span><strong>Fixed flat monthly fee</strong> regardless of tip size</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-primary font-bold">✓</span>
							<span>Single integrated bureau for wages + tips</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-primary font-bold">✓</span>
							<span>One single monthly data submission</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-primary font-bold">✓</span>
							<span>Full Tips Act & HMRC compliance covered</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<div class="site-container my-2 border-b border-dashed border-neutral-200 dark:border-neutral-800"></div>

	<section class="site-container py-16 md:py-24">
		<SectionHeader
			title="How the Combined Scheme Works"
			description="From initial setup to monthly payslip distribution, we make Tronc and payroll effortless."
		/>
		<div class="mt-10 grid gap-6 md:grid-cols-4">
			{steps.map((item) => (
				<div class="relative rounded-xl border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-900">
					<div class="mb-4 text-3xl font-extrabold text-primary/30">
						{item.step}
					</div>
					<h3 class="mb-2 text-base font-bold text-neutral-900 dark:text-neutral-100">{item.title}</h3>
					<p class="text-xs leading-relaxed text-neutral-600 dark:text-neutral-400">{item.desc}</p>
				</div>
			))}
		</div>
	</section>

	<section class="site-container py-12 md:py-20">
		<div class="rounded-2xl bg-gradient-to-br from-primary to-[#122d78] p-8 text-center text-white shadow-xl md:p-14">
			<div class="mx-auto mb-4 grid h-12 w-12 place-items-center rounded-xl bg-white/10 text-white backdrop-blur">
				<Sparkles class="h-6 w-6" />
			</div>
			<h2 class="mx-auto mb-4 max-w-2xl text-3xl font-extrabold tracking-tight md:text-4xl">
				Ready to stop paying a percentage of your tips?
			</h2>
			<p class="mx-auto mb-8 max-w-2xl text-white/85 text-base md:text-lg">
				Get a tailored quote for your venue. We will calculate your estimated savings compared to percentage-based operators and outline your complete setup.
			</p>
			<div class="flex flex-wrap justify-center gap-4">
				<Button url="/contact" type="outline">
					Get Your Custom Quote <ArrowRight size={16} />
				</Button>
				<Button url="/about">
					About TroncPAYE
				</Button>
			</div>
		</div>
	</section>
</Layout>
